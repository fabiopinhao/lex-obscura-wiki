<meta name="description" content="{{ userComputed.description }}">
<link rel="canonical" href="{{ meta.siteBaseUrl }}{{ page.url }}">
<meta property="og:site_name" content="{{ meta.siteName }}">
<meta property="og:locale" content="{% if userComputed.isEn %}en_US{% else %}pt_BR{% endif %}">
{%- if userComputed.bilingual %}
{%- for l in userComputed.langs %}{% if l.url %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ meta.siteBaseUrl }}{{ l.url }}">
{%- endif %}{% endfor %}
{%- for l in userComputed.langs %}{% if l.code == "en" and l.url %}
<link rel="alternate" hreflang="x-default" href="{{ meta.siteBaseUrl }}{{ l.url }}">
{%- endif %}{% endfor %}
{%- endif %}
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
<meta property="og:title" content="{% if title and title != meta.siteName %}{{ title }} · {% endif %}{{ meta.siteName }}">
<meta property="og:description" content="{{ userComputed.description }}">
<meta property="og:url" content="{{ meta.siteBaseUrl }}{{ page.url }}">
<meta property="og:image" content="{{ meta.siteBaseUrl }}/img/og-card.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#0d0c0f">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">

<nav class="lex-explore" aria-label="{{ userComputed.ui.explore }}">
  <div class="lex-explore-title">{{ userComputed.ui.explore }}</div>
  <ul>
    {%- for s in userComputed.nav %}
    <li><a href="{{ s.url }}"{% if userComputed.section and userComputed.section.url == s.url %} class="is-current"{% endif %}>{{ s.label }}</a></li>
    {%- endfor %}
  </ul>
</nav>
